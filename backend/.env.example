# Port the NestJS HTTP server listens on
PORT=3000

# MongoDB connection string.
# Local example:  mongodb://127.0.0.1:27017/modulus17
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/modulus17
MONGODB_URI=mongodb://127.0.0.1:27017/modulus17

# Secret used to sign JWTs. Use a long, random string in real environments.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret

# How long an access token stays valid (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=7d
